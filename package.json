{
  "name": "ai-video-editor",
  "version": "1.0.0",
  "description": "AI Video Editor",
  "main": "dist-electron/main.js",
  "build": {
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "node_modules/@remotion/compositor-win32-x64-msvc/**/*",
      "dist-remotion/**/*"
    ],
    "win": {
      "signAndEditExecutable": false
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && remotion bundle src/remotion/index.ts --out-dir=dist-remotion && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/genai": "^2.14.0",
    "@remotion/player": "^4.0.165",
    "@remotion/renderer": "^4.0.165",
    "axios": "^1.6.8",
    "clsx": "^2.1.1",
    "lucide-react": "^0.379.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "^4.0.165",
    "tailwind-merge": "^2.3.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.165",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}
